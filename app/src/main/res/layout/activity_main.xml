<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#121212">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#1A2C3D"
            android:titleTextColor="#FFFFFF"
            android:elevation="10dp"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:title="NetstatApp" />

        <LinearLayout
            android:id="@+id/todayPinnedCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/neon_card_bg"
            android:layout_margin="10dp"
            android:padding="14dp"
            android:elevation="4dp">

            <TextView android:id="@+id/pinnedDate" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1.3" android:text="Today" android:textColor="#4FC3F7" android:textStyle="bold" android:textSize="15sp" />
            <TextView android:id="@+id/pinnedMobile" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="end" android:textColor="#FFFFFF" android:textSize="15sp" />
            <TextView android:id="@+id/pinnedWifi" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="end" android:textColor="#FFFFFF" android:textSize="15sp" android:paddingStart="8dp" />
            <TextView android:id="@+id/pinnedTotal" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="end" android:textColor="#FFFFFF" android:textSize="15sp" android:paddingStart="8dp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#2A2A2A"
            android:padding="12dp">

            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1.3" android:text="Date" android:textColor="#AAAAAA" android:textStyle="bold" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="end" android:text="Mobile" android:textColor="#AAAAAA" android:textStyle="bold" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="end" android:text="WiFi" android:textColor="#AAAAAA" android:textStyle="bold" android:paddingStart="8dp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="end" android:text="Total" android:textColor="#AAAAAA" android:textStyle="bold" android:paddingStart="8dp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#444444" />

        <TextView android:id="@+id/tvWeekTotal" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="12dp" android:background="#003355" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp" />

        <TextView android:id="@+id/tvMonthTotal" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="12dp" android:background="#001C33" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#1A1A1A">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:text="Menu"
            android:textColor="#4FC3F7"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="#0D1B2A" />

        <TextView
            android:id="@+id/navSpeedLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:text="Live Speed Log"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/navDataTools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:text="Export / Import"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/navAppUsage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:text="App Usage"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

        <TextView
            android:id="@+id/navAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:text="About"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
